# ===================================================================
# ETHEREUM BOT CONFIGURATION
# ===================================================================
PRIVATE_KEY=your_private_key_here
DESTINATION_ADDRESS=0xYourDestinationAddressHere

# ===================================================================
# RPC ENDPOINTS - PRIMARY MUST BE wss:// (WebSocket) for event-driven + mempool mode
# Use 2+ different providers: the signed tx is broadcast to ALL of them in parallel
# ===================================================================
RPC_URL_PRIMARY=wss://your-primary-websocket-rpc
RPC_URL_SECONDARY=https://your-secondary-rpc
RPC_URL_TERTIARY=
RPC_URL_BACKUP_1=
RPC_URL_BACKUP_2=
RPC_URL_BACKUP_3=

# ===================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# ===================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
TELEGRAM_PASSWORD=your_secure_password

# ===================================================================
# BOT SETTINGS
# ===================================================================
PORT=5000
USE_EVENT_DRIVEN=true
POLL_INTERVAL=30
MAX_RETRY_ATTEMPTS=3

# ===================================================================
# SPEED OPTIONS
# ===================================================================
# Mempool monitor + pre-signed sweep: ON by default. Set to false to disable.
ENABLE_MEMPOOL_MONITOR=true
# Priority fee (tip) in gwei. Higher = earlier in block, costs more (21000 gas * tip). Optional.
# PRIORITY_FEE_GWEI=3
# Headroom % above the current base fee for the EOA sweep (minimises leftover ETH).
# Lower = less dust left behind, but a sudden base-fee spike above this % can delay
# the transfer until the bot's automatic Replace-by-Fee (RBF) kicks in (~180s). Default: 20
# FEE_HEADROOM_PERCENT=20

# How many ms with NO new block before the bot assumes the WebSocket died silently
# (no close/error event) and forces a reconnect. Default: 45000 (45s, ~3-4 blocks)
# WATCHDOG_STALL_MS=45000
